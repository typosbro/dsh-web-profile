{
  "name": "@local/voice-mode",
  "version": "0.2.0",
  "private": true,
  "description": "Continuous, fully local voice conversation for the dsh Web GUI: local SenseVoice STT, local Kokoro TTS, barge-in interruption",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "README.md",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "index.js",
    "lib",
    "locale/en.json",
    "scripts",
    "tools"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "dependencies": {}
}
